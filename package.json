{
  "name": "anirec",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev:ext": "pnpm --filter @anirec/extension dev",
    "dev:server": "pnpm --filter @anirec/server dev",
    "build": "turbo run build --log-order=grouped",
    "typecheck": "turbo run typecheck --continue --log-order=grouped",
    "check": "biome check --write .",
    "check:dry": "biome check .",
    "test": "turbo run test:run --continue --log-order=grouped"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "tsup": "^8.3.5",
    "turbo": "~2.9.18",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  }
}
